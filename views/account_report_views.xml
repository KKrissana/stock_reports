<?xml version="1.0" encoding="utf-8"?>
<odoo>
   <record id="account_report_form" model="ir.ui.view">
       <field name="name">account.report.form.view.inherit.account.filter</field>
       <field name="inherit_id" ref="account_reports.account_report_form"/>
       <field name="model">account.report</field>
       <field name="arch" type="xml">
           <xpath expr="//field[@name='filter_partner']" position="after">
                <field name="filter_product"/>
                <field name="filter_picking"/>
           </xpath>
       </field>
   </record>
</odoo>