<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="stock_valuation_report" model="account.report">
        <field name="name">Stock Valuation</field>
        <field name="filter_hierarchy">optional</field>
        <field name="filter_unfold_all" eval="True"/>
        <field name="filter_show_draft" eval="False"/>
        <field name="filter_period_comparison" eval="False"/>
        <field name="filter_journals" eval="False"/>
        <field name="filter_product" eval="True" />
        <field name="filter_picking" eval="False" />
        <field name="custom_handler_model_id" ref="model_stock_valuation_report_handler"/>
        <field name="load_more_limit" eval="80"/>
        <field name="column_ids">
            <!-- <record id="stock_valuation_report_product_name" model="account.report.column">
                <field name="name">Product</field>
                <field name="expression_label">product_name</field>
                <field name="figure_type">string</field>
            </record> -->
            <record id="stock_valuation_report_product_code" model="account.report.column">
                <field name="name">Reference</field>
                <field name="expression_label">product_code</field>
                <field name="figure_type">string</field>
                <field name="sequence">100</field>
            </record>
            <record id="stock_valuation_report_uom_name" model="account.report.column">
                <field name="name">uom</field>
                <field name="expression_label">uom_name</field>
                <field name="figure_type">string</field>
                <field name="sequence">110</field>
            </record>
            <record id="stock_valuation_report_qty_init" model="account.report.column">
                <field name="name">Quantity Initial Balance</field>
                <field name="expression_label">qty_init</field>
                <field name="figure_type">float</field>
                <field name="sequence">120</field>
            </record>
            <record id="stock_valuation_report_qty_plus" model="account.report.column">
                <field name="name">+</field>
                <field name="expression_label">qty_plus</field>
                <field name="figure_type">float</field>
                <field name="sequence">130</field>
            </record>
            <record id="stock_valuation_report_qty_minus" model="account.report.column">
                <field name="name">-</field>
                <field name="expression_label">qty_minus</field>
                <field name="figure_type">float</field>
                <field name="sequence">140</field>
            </record>
            <record id="stock_valuation_report_qty_balance" model="account.report.column">
                <field name="name">Quantity Balance</field>
                <field name="expression_label">qty_balance</field>
                <field name="figure_type">float</field>
                <field name="sequence">150</field>
            </record>
            <record id="stock_valuation_report_value_init" model="account.report.column">
                <field name="name">Valuation Initial Balance</field>
                <field name="expression_label">value_init</field>
                <field name="figure_type">monetary</field>
                <field name="sequence">160</field>
            </record>
            <record id="stock_valuation_report_value_plus" model="account.report.column">
                <field name="name">+</field>
                <field name="expression_label">value_plus</field>
                <field name="figure_type">monetary</field>
                <field name="sequence">170</field>
            </record>
            <record id="stock_valuation_report_value_minus" model="account.report.column">
                <field name="name">-</field>
                <field name="expression_label">value_minus</field>
                <field name="figure_type">monetary</field>
                <field name="sequence">180</field>
            </record>
            <record id="stock_valuation_report_value_balance" model="account.report.column">
                <field name="name">Valuation Balance</field>
                <field name="expression_label">value_balance</field>
                <field name="figure_type">monetary</field>
                <field name="sequence">190</field>
            </record>

        </field>
    </record>
</odoo>