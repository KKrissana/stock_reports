<?xml version="1.0" encoding="UTF-8" ?>
<template>
    
    <!-- Inherit AccountReportFilterExtraOptions -->
    <t t-name="stock_reports.StockMoveFilterExtraOptions" t-inherit="account_reports.AccountReportFilterExtraOptions" t-inherit-mode="extension">
        <xpath expr="//t[@t-if='controller.options.integer_rounding']" position="after">
            <t t-if="['incoming', 'outgoing', 'valuation'].includes(controller.options['stock_grouping'])">
                <div class="dropdown-divider" />
                <DropdownItem
                    class="{ 'selected': controller.options.track_inventory }"
                    onSelected="() => this.filterClicked({ optionKey: 'track_inventory', reload: true})"
                    closingMode="'none'" >
                    Track Inventory
                </DropdownItem>
                <DropdownItem
                    class="{ 'selected': controller.options.none_track_inventory }"
                    onSelected="() => this.filterClicked({ optionKey: 'none_track_inventory', reload: true})"
                    closingMode="'none'" >
                    No Track Inventory
                </DropdownItem>
            </t>
            
            <t t-if="['incoming', 'outgoing'].includes(controller.options['stock_grouping'])">

                <div class="dropdown-divider" />
                 <DropdownItem t-if="['outgoing'].includes(controller.options['stock_grouping'])"
                    class="{ 'selected': controller.options.sale_to_customer }"
                    onSelected="() => this.filterClicked({ optionKey: 'sale_to_customer', reload: true})"
                    closingMode="'none'" >
                    Sale
                </DropdownItem>
                <DropdownItem t-if="['incoming'].includes(controller.options['stock_grouping'])"
                    class="{ 'selected': controller.options.purchase_to_stock }"
                    onSelected="() => this.filterClicked({ optionKey: 'purchase_to_stock', reload: true})"
                    closingMode="'none'" >
                    Purchase
                </DropdownItem>
                <DropdownItem
                    class="{ 'selected': controller.options.mrp_operation }"
                    onSelected="() => this.filterClicked({ optionKey: 'mrp_operation', reload: true})"
                    closingMode="'none'" >
                    Production
                </DropdownItem>
                <DropdownItem
                    class="{ 'selected': controller.options.vendor_return }"
                    onSelected="() => this.filterClicked({ optionKey: 'vendor_return', reload: true})"
                    closingMode="'none'" >
                    Vendor Return
                </DropdownItem>
                <DropdownItem
                    class="{ 'selected': controller.options.customer_return }"
                    onSelected="() => this.filterClicked({ optionKey: 'customer_return', reload: true})"
                    closingMode="'none'" >
                    Customer Return
                </DropdownItem>
                <DropdownItem
                    class="{ 'selected': controller.options.mrp_operation_return }"
                    onSelected="() => this.filterClicked({ optionKey: 'mrp_operation_return', reload: true})"
                    closingMode="'none'" >
                    Production Return
                </DropdownItem>
                <DropdownItem
                    class="{ 'selected': controller.options.inventory_loss }"
                    onSelected="() => this.filterClicked({ optionKey: 'inventory_loss', reload: true})"
                    closingMode="'none'" >
                    Inventory Adjustment 
                </DropdownItem>
            </t>

            <t t-if="['incoming', 'outgoing'].includes(controller.options['stock_grouping'])">
                <div class="dropdown-divider" />
                <DropdownItem
                    class="{ 'selected': controller.options.show_origin }"
                    onSelected="() => this.filterClicked({ optionKey: 'show_origin', reload: true})"
                    closingMode="'none'" >
                    Show Source
                </DropdownItem>
                <DropdownItem
                    class="{ 'selected': controller.options.show_partner }"
                    onSelected="() => this.filterClicked({ optionKey: 'show_partner', reload: true})"
                    closingMode="'none'" >
                    Show Partner
                </DropdownItem>
                <DropdownItem t-if="['incoming'].includes(controller.options['stock_grouping'])"
                    class="{ 'selected': controller.options.show_inv_note }"
                    onSelected="() => this.filterClicked({ optionKey: 'show_inv_note', reload: true})"
                    closingMode="'none'" >
                    Show Invoice/Delivery Note
                </DropdownItem>
                <DropdownItem t-if="['outgoing'].includes(controller.options['stock_grouping'])"
                    class="{ 'selected': controller.options.show_machine }"
                    onSelected="() => this.filterClicked({ optionKey: 'show_machine', reload: true})"
                    closingMode="'none'" >
                    Show Machine/Equipment
                </DropdownItem>
                <DropdownItem t-if="'display_analytic' in controller.options"
                    class="{ 'selected': controller.options.show_analytic_account }"
                    onSelected="() => this.filterClicked({ optionKey: 'show_analytic_account', reload: true})"
                    closingMode="'none'" >
                    Show Analytic Account
                </DropdownItem>
                <DropdownItem
                    class="{ 'selected': controller.options.show_stock_account }"
                    onSelected="() => this.filterClicked({ optionKey: 'show_stock_account', reload: true})"
                    closingMode="'none'" >
                    Show Stock Account
                </DropdownItem>
                <DropdownItem
                    class="{ 'selected': controller.options.show_counterpart_account }"
                    onSelected="() => this.filterClicked({ optionKey: 'show_counterpart_account', reload: true})"
                    closingMode="'none'" >
                    Show Counterpart Account
                </DropdownItem>
            </t>
        </xpath>
    </t>

</template>