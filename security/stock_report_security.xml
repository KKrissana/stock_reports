<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <data noupdate="1">
    
        <record model="ir.rule" id="stock_valuation_report_company_rule">
            <field name="name">Stock Valuation Report Multicompany</field>
            <field name="model_id" search="[('model','=','stock.valuation.report')]" model="ir.model"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="group_stock_audit_report" model="res.groups">
            <field name="name">Stock Audit Report</field>
            <field name="category_id" ref="base.module_category_hidden"/>
        </record>
    
        <record id="group_stock_valuation_report" model="res.groups">
            <field name="name">Stock Valuation Report</field>
            <field name="category_id" ref="base.module_category_hidden"/>
        </record>

    </data>

</odoo>
